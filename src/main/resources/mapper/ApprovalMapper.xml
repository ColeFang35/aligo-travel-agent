<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.aligo.travel.dao.ApprovalMapper">

    <resultMap id="approvalMap" type="io.aligo.travel.dao.Approval">
        <id     property="applyId"     column="apply_id"/>
        <result property="applicant"   column="applicant"/>
        <result property="destination" column="destination"/>
        <result property="travelDate"  column="travel_date"/>
        <result property="budget"      column="budget"/>
        <result property="reason"      column="reason"/>
        <result property="status"      column="status"/>
        <result property="sla"         column="sla"/>
        <result property="applyTime"   column="apply_time"/>
    </resultMap>

    <!-- 新增：审计由数据库触发器 trg_approval_after_insert 自动写 -->
    <insert id="insert" parameterType="io.aligo.travel.dao.Approval">
        INSERT INTO travel_approval
            (apply_id, applicant, destination, travel_date, budget, reason, status, sla, apply_time)
        VALUES
            (#{applyId}, #{applicant}, #{destination}, #{travelDate}, #{budget},
             #{reason}, #{status}, #{sla}, #{applyTime})
    </insert>

    <select id="findAll" resultMap="approvalMap">
        SELECT apply_id, applicant, destination, travel_date, budget, reason, status, sla, apply_time
        FROM travel_approval
        ORDER BY apply_id DESC
    </select>

    <select id="findById" resultMap="approvalMap">
        SELECT apply_id, applicant, destination, travel_date, budget, reason, status, sla, apply_time
        FROM travel_approval WHERE apply_id = #{applyId}
    </select>

    <!-- 单号在 SQL 内计算，应用层不维护自增状态 -->
    <select id="nextApplyId" resultType="java.lang.String">
        SELECT CONCAT('OA-', LPAD(IFNULL(MAX(CAST(SUBSTRING(apply_id, 4) AS UNSIGNED)), 0) + 1, 5, '0'))
        FROM travel_approval
    </select>

    <!-- 状态流转走存储过程 -->
    <update id="approveByProcedure" statementType="CALLABLE">
        {call sp_approve_application(#{applyId, mode=IN}, #{status, mode=IN})}
    </update>

    <!-- 按月统计走存储过程 -->
    <select id="statsByMonth" statementType="CALLABLE" resultType="java.util.Map">
        {call sp_approval_stats_by_month(#{year, mode=IN, jdbcType=INTEGER},
                                         #{month, mode=IN, jdbcType=INTEGER})}
    </select>

    <!-- 目的地计数走数据库函数 -->
    <select id="countByDestination" resultType="java.lang.Integer">
        SELECT fn_count_by_destination(#{destination})
    </select>

</mapper>
